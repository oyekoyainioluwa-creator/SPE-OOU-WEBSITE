# SPE OOU Website — Environment Configuration
# Copy this file to .env and adjust. NEVER commit .env.

PORT=3000

# Initial admin account (used ONLY if no admin exists yet — change after first login)
ADMIN_EMAIL=admin@speoou.org
ADMIN_NAME=SPE OOU Admin
ADMIN_PASSWORD=ChangeMe123!

# Long random secret for signing sessions (change in production!)
JWT_SECRET=change-this-to-a-long-random-secret-string

# Comma-separated list of allowed upload origins (optional)
# ALLOWED_ORIGINS=https://speoou.org
